{
  "manifest_version": 3,
  "key": "",
  "name": "StackNest — Tab Manager",
  "short_name": "StackNest",
  "version": "1.0.0",
  "description": "A calm new tab for your tabs and bookmarks. Save windows as collections, tidy your library, clear duplicates and keep notes.",
  "homepage_url": "https://github.com/bitwilll/stacknest_TabManager",
  "minimum_chrome_version": "128",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open StackNest",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "js/sw.js",
    "type": "module"
  },
  "incognito": "spanning",
  "permissions": [
    "tabs",
    "bookmarks",
    "favicon",
    "storage",
    "identity",
    "notifications",
    "alarms"
  ],
  "oauth2": {
    "client_id": "599136003782-49rr17vnbjhf2a8acgd3ftlmi17oqtb0.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; connect-src 'self' https://www.googleapis.com https://oauth2.googleapis.com https://api.coingecko.com https://open.er-api.com; img-src 'self' data:"
  }
}
